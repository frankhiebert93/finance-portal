# Copy to .env.local and fill in real values. Never commit .env.local.
# Next.js loads env files from this directory (the Next project root).

# Supabase (server-side only — intentionally NOT prefixed with NEXT_PUBLIC_).
# The app connects with the service-role key and relies on RLS being enabled to
# deny the anon role (see supabase/migrations/0001_enable_rls.sql). The
# service-role key bypasses RLS and must NEVER be exposed to the browser.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_KEY="your-service-role-key"

# The PIN required to unlock the app. No default — unlock fails if unset.
APP_PIN="change-me"

# Secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be at least 16 chars; rotating it logs everyone out.
APP_SESSION_SECRET="generate-a-random-32-byte-hex-string"
